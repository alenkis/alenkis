---
interface Post {
  slug: string;
  data: {
    title: string;
    description: string;
    date: Date;
    categories: string[];
  };
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Get all unique tags
const allTags = [...new Set(posts.flatMap(post => post.data.categories))].sort();

// Get all unique years (sorted descending)
const allYears = [...new Set(posts.map(post => post.data.date.getFullYear()))].sort((a, b) => b - a);

// Serialize posts for client-side filtering
const postsData = posts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
  year: post.data.date.getFullYear(),
  categories: post.data.categories,
  formattedDate: post.data.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }),
}));
---

<div class="post-list">
  <!-- Search -->
  <div class="search-wrapper">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="text"
      id="search-input"
      placeholder="Search posts..."
      autocomplete="off"
    />
  </div>

  <!-- Filters -->
  <div class="filters">
    <div class="filter-group">
      <div class="filter-chips">
        <button class="chip active" data-tag="all">All</button>
        {allTags.map(tag => (
          <button class="chip tag-filter" data-tag={tag}>{tag}</button>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <div class="filter-chips">
        {allYears.map(year => (
          <button class="chip year-filter" data-year={year}>{year}</button>
        ))}
      </div>
    </div>
  </div>

  <!-- Posts -->
  <div id="posts-container" class="posts">
    {postsData.map(post => (
      <a
        href={`/${post.slug}`}
        class="post-card"
        data-categories={JSON.stringify(post.categories)}
        data-title={post.title.toLowerCase()}
        data-description={post.description.toLowerCase()}
        data-year={post.year}
      >
        <div class="post-meta">
          <time>{post.formattedDate}</time>
          <div class="post-tags">
            {post.categories.map(cat => (
              <span class="tag">{cat}</span>
            ))}
          </div>
        </div>
        <h2 class="post-title">{post.title}</h2>
        <p class="post-description">{post.description}</p>
        <span class="read-more">Read article →</span>
      </a>
    ))}
  </div>

  <!-- No results -->
  <div id="no-results" class="no-results hidden">
    <p>No posts found</p>
  </div>
</div>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Search */
  .search-wrapper {
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    pointer-events: none;
  }

  #search-input {
    width: 100%;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    font-size: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-primary);
    transition: all 0.15s ease;
  }

  #search-input::placeholder {
    color: var(--text-secondary);
  }

  #search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
  }

  .dark #search-input:focus {
    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.1);
  }

  /* Filters */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 100px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  /* Posts */
  .posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .dark .post-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .post-meta time {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    background: var(--bg);
    border-radius: 100px;
    color: var(--text-secondary);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0 0 1rem 0;
    line-height: 1.6;
  }

  .read-more {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  .post-card:hover .read-more {
    text-decoration: underline;
  }

  /* Hidden state */
  .post-card.hidden {
    display: none;
  }

  /* No results */
  .no-results {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
  }

  .no-results.hidden {
    display: none;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .post-card {
      padding: 1.25rem;
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .post-title {
      font-size: 1.125rem;
    }
  }
</style>

<script>
  function initPostList() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const tagFilters = document.querySelectorAll('.chip[data-tag]');
    const yearFilters = document.querySelectorAll('.chip[data-year]');
    const noResults = document.getElementById('no-results');
    const postItems = document.querySelectorAll('.post-card');

    let activeTag = 'all';
    let activeYear = 'all';
    let searchQuery = '';

    function filterPosts() {
      let visibleCount = 0;

      postItems.forEach(item => {
        const post = item as HTMLElement;
        const categories: string[] = JSON.parse(post.dataset.categories || '[]');
        const title = post.dataset.title || '';
        const description = post.dataset.description || '';
        const year = post.dataset.year || '';

        const matchesTag = activeTag === 'all' || categories.includes(activeTag);
        const matchesYear = activeYear === 'all' || year === activeYear;
        const matchesSearch = searchQuery === '' ||
          title.includes(searchQuery.toLowerCase()) ||
          description.includes(searchQuery.toLowerCase()) ||
          categories.some(cat => cat.toLowerCase().includes(searchQuery.toLowerCase()));

        if (matchesTag && matchesYear && matchesSearch) {
          post.classList.remove('hidden');
          visibleCount++;
        } else {
          post.classList.add('hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      filterPosts();
    });

    tagFilters.forEach(filter => {
      filter.addEventListener('click', () => {
        tagFilters.forEach(f => f.classList.remove('active'));
        filter.classList.add('active');
        activeTag = (filter as HTMLElement).dataset.tag || 'all';
        filterPosts();
      });
    });

    yearFilters.forEach(filter => {
      filter.addEventListener('click', () => {
        const isActive = filter.classList.contains('active');
        yearFilters.forEach(f => f.classList.remove('active'));

        if (isActive) {
          activeYear = 'all';
        } else {
          filter.classList.add('active');
          activeYear = (filter as HTMLElement).dataset.year || 'all';
        }
        filterPosts();
      });
    });
  }

  initPostList();
  document.addEventListener('astro:after-swap', initPostList);
</script>
