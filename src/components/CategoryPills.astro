---
interface Props {
  categories: string[];
}

const { categories = [] } = Astro.props;
---

<div class="flex flex-wrap gap-1 mt-2">
  {categories.map((category) => (
    <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
      {category}
    </span>
  ))}
</div>
