---
import CategoryPills from './CategoryPills.astro';

interface Props {
  title: string;
  slug: string;
  date: Date;
  description: string;
  categories: string[];
}

const { title, slug, date, description, categories } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="mb-8">
  <header>
    <h3 class="text-xl mb-1">
      <a href={`/${slug}`} class="no-underline hover:opacity-80" style="box-shadow: none;">
        {title}
      </a>
    </h3>
    <small class="opacity-60">{formattedDate}</small>
    <CategoryPills categories={categories} />
  </header>
  <section class="mt-2">
    <p class="opacity-80">{description}</p>
  </section>
</article>
